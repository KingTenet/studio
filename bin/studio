#!/usr/bin/env bash
# The studio's one command. `studio up` updates this harness (git pull --ff-only; when that fails it carries on
# with the version there is), builds the cockpit page if it is missing or out of date, starts the studio's herdr
# workspace, or completes it if it's already there, and opens the cockpit at http://localhost:4000.
#
# The workspace has a tab for each of these:
#   claude   Claude working on the app, in auto mode with claude/settings.json (its hooks and allowlist) and
#            this folder as a plugin (its skills/), continuing the app's last conversation if it has one
#   studio   the cockpit's server (scripts/lib/studio-server.js)
#   app      the app's dev server (npm run dev, on the app's port, 4001), its output also in data/logs/dev.log
#   whisper  whisper-server, which turns the cockpit's dictation into text (on 127.0.0.1:8178)
#   reaper   keeps Claude running: when it has died, starts it again in the claude tab with --continue (claude-reaper.sh keep),
#            and the chat says "Reconnected"
# A tab that is running is left alone, so running `studio up` again reuses the workspace. A tab left at its
# shell prompt (its command exited, or herdr restored it after a restart) runs its command again. After an
# update the studio tab is restarted, so the new server code is the one running.
#
# `studio new <app> [--collaborator <github user>]` makes a new app in ~/Studio/<app> from template/app.bundle (versions
# v1 and v2, with develop = main), or clones it if your GitHub account already has a repo by that name (a new Mac), makes it a
# private GitHub repo with main, develop and the version tags pushed, invites the collaborator, puts an app in
# ~/Applications that runs it with `studio run` (an error shows as a dialog), and makes it the app the
# studio works on: with no app yet it writes config.json, otherwise it runs `studio switch <app>`. Run again, it skips
# what's already done. It needs GitHub logged in (install.sh does that).
#
# `studio switch <app>` makes another app the one the studio works on (an app's name in ~/Studio, or its folder):
# it waits for Claude to finish, points config.json's appDir at it, closes the tabs that run in the old app's
# folder (reaper, claude, app) and runs `studio up`, which starts them again in the new one. Each app keeps its
# own open feature, data snapshots and Claude conversation, so switching back carries on where it left off.
#
# `studio run [<app>]` runs the app for real, apart from the studio (default: the app config.json names). It runs
# the newest version kept (vN), from its own copy in ~/Studio/.live/<app>/code (a git worktree, detached at the
# tag), on its own data in ~/Studio/.live/<app>/data, which nothing in the studio ever rewinds, at
# http://localhost:5001, in the background (its output in ~/Studio/.live/<app>/app.log). Run again, it opens the
# browser, and when a newer version has been kept since, moves to it first: it stops the running one, copies the
# database to ~/Studio/.live/<app>/backups/ and checks out the new tag, whose migrations then run on its data.
# It only ever moves forward. `studio new` puts an app in ~/Applications that runs it, so no terminal is needed.
#
# Usage: studio up [--dry-run]   # --dry-run prints what each tab would run and changes nothing
#        studio new <app> [--collaborator <github user>]
#        studio switch <app>
#        studio run [<app>]
#        studio logs              # puts the studio's logs in one zip on the Desktop, to send to whoever helps
#        studio down              # stops the studio (Claude, the cockpit, the app's dev server, dictation): `studio up`
#                                 # then starts it all afresh, on the newest version, and Claude carries on its conversation
#
# Logs, in ~/.studio/logs: commands.log (what every studio command printed), studio.log and reaper.log (those tabs'
# output), sessions.jsonl (which conversation the chat's Claude runs, and what the studio typed into it), actions.jsonl
# (the cockpit's actions) and job-*.log. One past 5 MB is cut to its last 1 MB.
#
# Environment: STUDIO_HOME (default ~/.studio, holding config.json with the app's appDir and appPort),
# STUDIO_PORT (the cockpit's port, default 4000), STUDIO_WHISPER_PORT (whisper-server's port, default 8178),
# STUDIO_WHISPER_MODEL (its model, default ~/.whisper/ggml-small.en.bin), STUDIO_WORKSPACE (the workspace's label, default studio),
# STUDIO_CLAUDE_CMD (run in place of claude, for trying this out), STUDIO_NO_OPEN=1 (don't open the browser),
# STUDIO_LIVE_PORT (where `studio run` serves the app, default 5001; not 5000, which AirPlay Receiver holds).
set -euo pipefail

# A step that fails says which, instead of studio stopping without a word.
trap 'echo "✗ studio stopped: this failed (line $LINENO of $0): $BASH_COMMAND" >&2' ERR

STUDIO_DIR="$(cd "$(dirname "$(realpath "$0")")/.." && pwd)"
export STUDIO_DIR
# pnpm can come from Corepack, which otherwise stops to ask before downloading it.
export COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# Homebrew's tools (herdr, gh, node, jq…), also in a Terminal window opened before the installer put Homebrew on the
# PATH. Added at the end, so whatever is on the PATH already comes first.
if ! command -v brew >/dev/null; then
  for dir in /opt/homebrew /usr/local; do
    [ -x "$dir/bin/brew" ] && { PATH="$PATH:$dir/bin:$dir/sbin"; break; }
  done
fi
export STUDIO_HOME="${STUDIO_HOME:-$HOME/.studio}"
export STUDIO_PORT="${STUDIO_PORT:-4000}"
export STUDIO_WHISPER_PORT="${STUDIO_WHISPER_PORT:-8178}"
WHISPER_MODEL="${STUDIO_WHISPER_MODEL:-$HOME/.whisper/ggml-small.en.bin}"
WORKSPACE="${STUDIO_WORKSPACE:-studio}"
CONFIG="$STUDIO_HOME/config.json"

usage() { echo "usage: studio up [--dry-run]   or   studio new <app> [--collaborator <github user>]   or   studio switch <app>   or   studio run [<app>]   or   studio logs   or   studio down" >&2; exit 2; }
DRY_RUN=false
case "${1:-} ${2:-}" in
  "up ") ;;
  "up --dry-run") DRY_RUN=true ;;
  new\ ?*) ;;
  switch\ ?*) [ $# -eq 2 ] || usage ;;
  run\ *) [ $# -le 2 ] || usage ;;
  "logs ") ;;
  "down ") ;;
  *) usage ;;
esac

LOGS="$STUDIO_HOME/logs"
mkdir -p "$LOGS"
for log in "$LOGS"/*.log "$LOGS"/*.jsonl; do
  if [ -f "$log" ] && [ "$(stat -f %z "$log")" -gt 5242880 ]; then
    tail -c 1048576 "$log" >"$log.tmp" && mv "$log.tmp" "$log"
  fi
done
# What every studio command prints also goes to commands.log, after a line saying when and what (once, not again when
# this script runs itself again).
if [ -z "${STUDIO_LOGGING:-}" ]; then
  export STUDIO_LOGGING=1
  echo "--- $(date '+%Y-%m-%d %H:%M:%S') studio $*" >>"$LOGS/commands.log"
  exec > >(tee -a "$LOGS/commands.log") 2> >(tee -a "$LOGS/commands.log" >&2)
fi

q() { printf "'%s'" "${1//\'/\'\\\'\'}"; }
config() { [ -f "$CONFIG" ] && jq -r "$1 // empty" "$CONFIG" || true; }

# An app's folder, from its name in ~/Studio or its folder.
app_folder() {
  local dir
  case "$1" in
    */*) dir="$1" ;;
    *) dir="$HOME/Studio/$1" ;;
  esac
  if [ ! -d "$dir/.git" ]; then
    echo "There's no app at $dir. Its name is its folder in ~/Studio: $(ls "$HOME/Studio" 2>/dev/null | paste -sd ' ' - || true)" >&2
    return 1
  fi
  (cd "$dir" && pwd -P)
}

# --- studio new -----------------------------------------------------------------------------------

if [ "$1" = new ]; then
  shift
  name="" collaborator=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --collaborator) [ $# -ge 2 ] || usage; collaborator=$2; shift 2 ;;
      -*) usage ;;
      *) [ -z "$name" ] || usage; name=$1; shift ;;
    esac
  done
  case "$name" in
    ""|*[!a-z0-9-]*|-*) echo "The app's name can only have lowercase letters, numbers and dashes, like my-app." >&2; exit 2 ;;
  esac
  command -v gh >/dev/null || { echo "Studio can't find gh, GitHub's command. Run ./install.sh in $STUDIO_DIR first." >&2; exit 1; }
  gh auth status >/dev/null 2>&1 || { echo "GitHub isn't logged in. Run ./install.sh in $STUDIO_DIR first." >&2; exit 1; }
  owner=$(gh api user --jq .login)
  repo="$owner/$name"
  dir="$HOME/Studio/$name"
  repo_url() { local url; url=$(gh repo view "$repo" --json url --jq .url); [ -n "$url" ] || { echo "GitHub didn't say where $repo is." >&2; exit 1; }; echo "$url.git"; }

  repo_exists=false
  gh repo view "$repo" >/dev/null 2>&1 && repo_exists=true
  if [ -d "$dir" ]; then
    echo "$dir is already there (left as it is)."
  elif [ "$repo_exists" = true ]; then
    echo "$repo is already on GitHub, so it's copied from there."
    mkdir -p "$(dirname "$dir")"
    url=$(repo_url)
    git clone --quiet "$url" "$dir"
    git -C "$dir" branch --quiet develop origin/develop 2>/dev/null || git -C "$dir" branch --quiet develop main
  else
    mkdir -p "$(dirname "$dir")"
    git clone --quiet --branch main "$STUDIO_DIR/template/app.bundle" "$dir"
    git -C "$dir" remote remove origin
    git -C "$dir" branch --quiet develop main
    echo "Made $name in $dir, with versions $(git -C "$dir" tag --list 'v*' | paste -sd ' ' -)."
  fi

  [ "$repo_exists" = true ] || gh repo create "$name" --private --description "Built with Studio" >/dev/null
  if ! git -C "$dir" remote get-url origin >/dev/null 2>&1; then
    url=$(repo_url)
    git -C "$dir" remote add origin "$url"
  fi
  # Only branches GitHub doesn't have yet: after that the studio pushes every change itself.
  for branch in main develop; do
    git -C "$dir" ls-remote --exit-code --heads origin "$branch" >/dev/null 2>&1 ||
      git -C "$dir" push --quiet --follow-tags origin "$branch"
  done
  echo "It's on GitHub, private, as $repo."

  if [ -n "$collaborator" ] && [ "$collaborator" != "$owner" ]; then
    gh api --method PUT "repos/$repo/collaborators/$collaborator" -f permission=push >/dev/null
    echo "$collaborator is invited to $repo (they accept the invitation on GitHub)."
  fi

  # A double-click runs `studio run` (the newest kept version, on its real data); an error shows as a dialog.
  launcher="$HOME/Applications/$name.app"
  if [ ! -d "$launcher" ] && command -v osacompile >/dev/null; then
    mkdir -p "$HOME/Applications"
    osacompile -o "$launcher" \
      -e 'try' \
      -e "do shell script \"export PATH=$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:\$PATH; studio run $name\"" \
      -e 'on error message' \
      -e "display dialog message buttons {\"OK\"} default button 1 with title \"$name\"" \
      -e 'end try'
    echo "$launcher runs $name for real: drag it into the Dock to open it with one click."
  fi

  current="$(config .appDir)"
  if [ -z "$current" ]; then
    mkdir -p "$STUDIO_HOME"
    [ -f "$CONFIG" ] || echo '{}' >"$CONFIG"
    jq --arg dir "$dir" --arg name "$name" '.appDir = $dir | .name = $name | .appPort //= 4001' "$CONFIG" >"$CONFIG.tmp"
    mv "$CONFIG.tmp" "$CONFIG"
    echo "The studio works on $name. To start it: studio up"
  elif [ "$(cd "$current" 2>/dev/null && pwd -P)" = "$(cd "$dir" && pwd -P)" ]; then
    echo "The studio already works on $name."
  else
    exec "$0" switch "$name"
  fi
  exit 0
fi

# --- studio down ----------------------------------------------------------------------------------

if [ "$1" = down ]; then
  ws=""
  herdr workspace list >/dev/null 2>&1 &&
    ws=$(herdr workspace list | jq -r --arg label "$WORKSPACE" '.result.workspaces[] | select(.label == $label) | .workspace_id' | head -n1)
  if [ -z "$ws" ]; then
    echo "The studio isn't running."
    exit 0
  fi
  # Not halfway through Claude's turn: a Build turn saves its checkpoint when it ends.
  claude_tab=$(herdr tab list --workspace "$ws" | jq -r '.result.tabs[] | select(.label == "claude") | .tab_id' | head -n1)
  if [ -n "$claude_tab" ]; then
    status=$(herdr pane list --workspace "$ws" | jq -r --arg tab "$claude_tab" '[.result.panes[] | select(.tab_id == $tab)][0].agent_status // "unknown"')
    case "$status" in
      working) echo "Claude is still working. Stop the studio when it has finished." >&2; exit 1 ;;
      blocked) echo "Claude is waiting for an answer in the chat. Stop the studio when it has finished." >&2; exit 1 ;;
    esac
  fi
  herdr workspace close "$ws" >/dev/null
  # Until its ports are free, a `studio up` straight after would find them taken.
  for _ in $(seq 1 40); do
    busy=false
    for port in "$STUDIO_PORT" "$(config .appPort)" "$STUDIO_WHISPER_PORT"; do
      [ -n "$port" ] && nc -z 127.0.0.1 "$port" 2>/dev/null && busy=true
    done
    [ "$busy" = false ] && break
    sleep 0.25
  done
  echo "The studio has stopped. To start it again (on the newest version): studio up"
  exit 0
fi

# --- studio logs ----------------------------------------------------------------------------------

if [ "$1" = logs ]; then
  stamp=$(date +%Y%m%d-%H%M%S)
  mkdir -p "$HOME/Desktop"
  out="$HOME/Desktop/studio-logs-$stamp.zip"
  work=$(mktemp -d)
  bundle="$work/studio-logs-$stamp"
  mkdir -p "$bundle"
  # The studio's logs, without the dictation clips (recordings of a voice).
  cp -R "$LOGS" "$bundle/logs"
  rm -rf "$bundle/logs/dictation"
  [ ! -f "$CONFIG" ] || cp "$CONFIG" "$bundle/config.json"
  app="$(config .appDir)"
  [ -z "$app" ] || [ ! -f "$app/data/logs/dev.log" ] || cp "$app/data/logs/dev.log" "$bundle/app-dev.log"
  [ ! -d "$HOME/.claude/state/panes" ] || cp -R "$HOME/.claude/state/panes" "$bundle/panes"
  for live in "$HOME"/Studio/.live/*/app.log; do
    [ ! -f "$live" ] || cp "$live" "$bundle/live-$(basename "$(dirname "$live")").log"
  done
  # What the Mac, the studio and the app look like now.
  (
    set +e
    trap - ERR
    echo "Made $(date)"
    sw_vers
    echo
    echo "Studio $STUDIO_DIR: $(git -C "$STUDIO_DIR" log -1 --format='%h %cd' --date=iso)"
    git -C "$STUDIO_DIR" status --short
    if [ -n "$app" ] && [ -d "$app/.git" ]; then
      echo
      echo "App $app, on $(git -C "$app" branch --show-current), versions $(git -C "$app" tag --list 'v*' --sort=-v:refname | head -n3 | paste -sd ' ' -)"
      git -C "$app" log --oneline -8
      git -C "$app" status --short
    fi
    echo
    for port in "$STUDIO_PORT" 4001 5001 "$STUDIO_WHISPER_PORT"; do
      if nc -z 127.0.0.1 "$port" 2>/dev/null; then echo "port $port: in use"; else echo "port $port: free"; fi
    done
    echo
    echo "node $(node --version 2>&1), $(claude --version 2>&1), herdr $(herdr --version 2>&1)"
    echo
    herdr pane list 2>&1
  ) >"$bundle/info.txt" 2>&1
  (cd "$work" && zip -qr "$out" "studio-logs-$stamp")
  rm -rf "$work"
  echo "Saved $out"
  echo "Send that file to whoever is helping you. It holds the studio's logs, not your messages to Claude."
  exit 0
fi

# --- studio switch --------------------------------------------------------------------------------

if [ "$1" = switch ]; then
  target="$(app_folder "$2")" || exit 1
  current="$(config .appDir)"
  if [ -n "$current" ] && [ "$(cd "$current" 2>/dev/null && pwd -P)" = "$target" ]; then
    echo "The studio is already working on $(basename "$target")."
    exec "$0" up
  fi

  # The workspace's tabs that run in the app's folder, the reaper first so it can't start Claude again in the old one.
  ws=""
  herdr workspace list >/dev/null 2>&1 &&
    ws=$(herdr workspace list | jq -r --arg label "$WORKSPACE" '.result.workspaces[] | select(.label == $label) | .workspace_id' | head -n1)
  if [ -n "$ws" ]; then
    claude_tab=$(herdr tab list --workspace "$ws" | jq -r '.result.tabs[] | select(.label == "claude") | .tab_id' | head -n1)
    # A Build turn makes its checkpoint when it stops, so the switch waits for Claude to finish (or answer).
    if [ -n "$claude_tab" ]; then
      status=$(herdr pane list --workspace "$ws" | jq -r --arg tab "$claude_tab" '[.result.panes[] | select(.tab_id == $tab)][0].agent_status // "unknown"')
      case "$status" in
        working) echo "Claude is still working. Switch when it has finished." >&2; exit 1 ;;
        blocked) echo "Claude is waiting for an answer in the chat. Switch when it has finished." >&2; exit 1 ;;
      esac
    fi
  fi

  [ -n "$current" ] && git -C "$current" rev-parse --verify -q develop >/dev/null &&
    ! GIT_TERMINAL_PROMPT=0 git -C "$current" push --quiet origin develop 2>/dev/null &&
    echo "⚠️  Couldn't push $(basename "$current")'s latest changes; they're pushed the next time you switch back."

  mkdir -p "$STUDIO_HOME"
  [ -f "$CONFIG" ] || echo '{}' >"$CONFIG"
  jq --arg dir "$target" --arg name "$(basename "$target")" '.appDir = $dir | .name = $name' "$CONFIG" >"$CONFIG.tmp"
  mv "$CONFIG.tmp" "$CONFIG"

  if [ -n "$ws" ]; then
    for name in reaper claude app; do
      tab=$(herdr tab list --workspace "$ws" | jq -r --arg label "$name" '.result.tabs[] | select(.label == $label) | .tab_id' | head -n1)
      [ -n "$tab" ] && herdr tab close "$tab" >/dev/null
    done
    # The new app's dev server needs the port the old one is letting go of.
    port="$(config .appPort)"
    for _ in $(seq 1 40); do
      lsof -nP -iTCP:"${port:-4001}" -sTCP:LISTEN >/dev/null 2>&1 || break
      sleep 0.25
    done
  fi
  echo "The studio now works on $(basename "$target")."
  exec "$0" up
fi

# --- studio run -----------------------------------------------------------------------------------

if [ "$1" = run ]; then
  if [ -n "${2:-}" ]; then
    app="$(app_folder "$2")" || exit 1
  else
    app="$(config .appDir)"
    app="$(app_folder "${app:-$HOME/Studio/my-app}")" || exit 1
  fi
  name="$(basename "$app")"
  LIVE="$HOME/Studio/.live/$name"
  CODE="$LIVE/code"
  PORT="${STUDIO_LIVE_PORT:-5001}"
  URL="http://localhost:$PORT"
  tag=$(git -C "$app" tag --list 'v*' --sort=-v:refname | head -n1)
  [ -n "$tag" ] || { echo "$name has no versions yet. Keep a feature first." >&2; exit 1; }

  running() { [ -f "$LIVE/app.pid" ] && kill -0 "$(cat "$LIVE/app.pid")" 2>/dev/null; }
  listener() { lsof -nP -tiTCP:"$PORT" -sTCP:LISTEN 2>/dev/null | head -n1; }
  stop() {
    running || return 0
    kill "$(cat "$LIVE/app.pid")" 2>/dev/null || true
    for _ in $(seq 1 40); do
      running || break
      sleep 0.25
    done
    rm -f "$LIVE/app.pid"
  }

  mkdir -p "$LIVE/data" "$LIVE/backups"
  if [ ! -e "$CODE/.git" ]; then
    git -C "$app" worktree prune
    git -C "$app" worktree add --quiet --detach "$CODE" "$tag"
  else
    current=$(git -C "$CODE" describe --tags --exact-match --match 'v*' 2>/dev/null || echo v0)
    # Only ever forward: the data has had this version's migrations, which an older one doesn't know.
    if [ "${current#v}" -lt "${tag#v}" ]; then
      stop
      if [ -f "$LIVE/data/app.db" ]; then
        cp "$LIVE/data/app.db" "$LIVE/backups/app-$current-$(date +%Y%m%d-%H%M%S).db"
        # The newest 20 are enough.
        ls -t "$LIVE/backups"/app-*.db | tail -n +21 | while read -r old; do rm -f "$old"; done
      fi
      git -C "$CODE" checkout --quiet --detach "$tag"
      echo "$name moved from $current to $tag. Its data was backed up first, to $LIVE/backups."
    fi
  fi

  if running; then
    echo "$name $tag is running."
  else
    if [ -n "$(listener)" ]; then
      echo "Something else is using port $PORT, so $name can't start." >&2
      exit 1
    fi
    # The app's secrets, from its own .env.
    [ -f "$app/.env" ] && ln -sfn "$app/.env" "$CODE/.env"
    lock=$(git -C "$CODE" rev-parse -q --verify HEAD:package-lock.json || echo none)
    if [ ! -d "$CODE/node_modules" ] || [ "$(cat "$LIVE/installed" 2>/dev/null)" != "$lock" ]; then
      echo "Installing what $name $tag needs…"
      (cd "$CODE" && npm ci --no-audit --no-fund --loglevel=error) >"$LIVE/app.log" 2>&1 || { tail -n 20 "$LIVE/app.log" >&2; exit 1; }
      echo "$lock" >"$LIVE/installed"
    fi
    (cd "$CODE" && npm run --silent build) >>"$LIVE/app.log" 2>&1 || { echo "$name $tag didn't build:" >&2; tail -n 20 "$LIVE/app.log" >&2; exit 1; }
    # All of its output to the log, so nothing holds this script's (the Dock app waits for those to close).
    (cd "$CODE" && DATA_DIR="$LIVE/data" PORT="$PORT" NODE_ENV=production exec nohup node_modules/.bin/tsx server/index.ts) >>"$LIVE/app.log" 2>&1 </dev/null &
    for _ in $(seq 1 120); do
      [ -n "$(listener)" ] && break
      sleep 0.25
    done
    # The process serving the app (tsx starts it as a child), so stopping it stops the app.
    pid=$(listener)
    if [ -z "$pid" ]; then
      echo "$name $tag didn't start:" >&2
      tail -n 20 "$LIVE/app.log" >&2
      exit 1
    fi
    echo "$pid" >"$LIVE/app.pid"
    echo "$name $tag is running."
  fi
  echo "It's at $URL"
  [ -n "${STUDIO_NO_OPEN:-}" ] || open "$URL"
  exit 0
fi

APP_DIR="$(config .appDir)"
APP_DIR="${APP_DIR:-$HOME/Studio/my-app}"
APP_PORT="$(config .appPort)"
APP_PORT="${APP_PORT:-4001}"
if [ ! -d "$APP_DIR" ]; then
  echo "There's no app at $APP_DIR. Make one with: studio new <name>" >&2
  exit 1
fi

# Claude's transcripts live in a folder named after the app's path; one there means a conversation to continue.
has_conversation() { compgen -G "$HOME/.claude/projects/$(printf %s "$APP_DIR" | sed 's/[^A-Za-z0-9]/-/g')/*.jsonl" >/dev/null; }

CLAUDE="claude --permission-mode auto --settings $(q "$STUDIO_DIR/claude/settings.json") --plugin-dir $(q "$STUDIO_DIR")"
has_conversation && CLAUDE="$CLAUDE --continue"
CLAUDE="${STUDIO_CLAUDE_CMD:-$CLAUDE}"

# Each tab: its label, the folder it starts in and its command.
TABS="claude studio app whisper reaper"
tab_cwd() { [ "$1" = studio ] && echo "$STUDIO_DIR" || echo "$APP_DIR"; }
tab_command() {
  case "$1" in
    claude) echo "$CLAUDE" ;;
    studio) echo "node $(q "$STUDIO_DIR/scripts/lib/studio-server.js") 2>&1 | tee -a $(q "$LOGS/studio.log")" ;;
    # Its output also goes to data/logs/dev.log, which the App tab shows and sends Claude when the app breaks (logs/ is never snapshotted).
    app) echo "[ -d node_modules ] || npm install; mkdir -p data/logs; PORT=$APP_PORT npm run dev 2>&1 | tee data/logs/dev.log" ;;
    # Its output (or why dictation is off) also goes to whisper.log.
    whisper)
      if ! command -v whisper-server >/dev/null; then echo "echo 'Dictation is off: whisper-server is not installed (brew install whisper-cpp).' | tee -a $(q "$LOGS/whisper.log")"
      elif ! command -v ffmpeg >/dev/null; then echo "echo 'Dictation is off: ffmpeg, which whisper-server needs, is not installed. Run the install line again (or brew install ffmpeg).' | tee -a $(q "$LOGS/whisper.log")"
      elif [ ! -f "$WHISPER_MODEL" ]; then echo "echo $(q "Dictation is off: there is no Whisper model at $WHISPER_MODEL.") | tee -a $(q "$LOGS/whisper.log")"
      else echo "whisper-server -m $(q "$WHISPER_MODEL") --host 127.0.0.1 --port $STUDIO_WHISPER_PORT --convert 2>&1 | tee -a $(q "$LOGS/whisper.log")"
      fi ;;
    # It starts Claude the way this script does, so it gets the stand-in for it too.
    reaper) echo "${STUDIO_CLAUDE_CMD:+STUDIO_CLAUDE_CMD=$(q "$STUDIO_CLAUDE_CMD") }$(q "$STUDIO_DIR/scripts/claude-reaper.sh") keep $(q "$WORKSPACE") $(q "$APP_DIR") 2>&1 | tee -a $(q "$LOGS/reaper.log")" ;;
  esac
}
tab_port() {
  case "$1" in
    studio) echo "$STUDIO_PORT" ;;
    app) echo "$APP_PORT" ;;
    whisper) echo "$STUDIO_WHISPER_PORT" ;;
  esac
}

if [ "$DRY_RUN" = true ]; then
  echo "Workspace $WORKSPACE, with STUDIO_DIR=$STUDIO_DIR STUDIO_HOME=$STUDIO_HOME STUDIO_PORT=$STUDIO_PORT STUDIO_WHISPER_PORT=$STUDIO_WHISPER_PORT"
  for name in $TABS; do echo "  $name (in $(tab_cwd "$name")): $(tab_command "$name")"; done
  exit 0
fi

# --- update and build -----------------------------------------------------------------------------

# A pull that brings changes reruns the new version of this script, which then restarts the studio server.
if [ -z "${STUDIO_UPDATED:-}" ]; then
  before=$(git -C "$STUDIO_DIR" rev-parse HEAD)
  if ! out=$(GIT_TERMINAL_PROMPT=0 git -C "$STUDIO_DIR" pull --ff-only --quiet 2>&1); then
    echo "⚠️  Couldn't update Studio, so starting the version you have. ($(echo "$out" | head -n1))"
  fi
  if [ "$(git -C "$STUDIO_DIR" rev-parse HEAD)" != "$before" ]; then
    echo "Studio was updated."
    STUDIO_UPDATED=1 exec "$0" "$@"
  fi
fi

# The app's develop, and anything whose push failed last time (feature.js), is pushed again in the background.
nohup node "$STUDIO_DIR/scripts/lib/feature.js" push "$APP_DIR" >/dev/null 2>&1 &

WEB="$STUDIO_DIR/web"
PAGE="$WEB/dist/cockpit.html"
if [ ! -f "$PAGE" ] || [ -n "$(find "$WEB/src" "$WEB/cockpit.html" "$WEB/package.json" "$WEB/pnpm-lock.yaml" "$WEB/vite.config.ts" -newer "$PAGE" -print -quit)" ]; then
  echo "Building the cockpit page…"
  pnpm --dir "$WEB" install --frozen-lockfile --silent
  pnpm --dir "$WEB" --silent build >/dev/null
fi

# --- the herdr workspace --------------------------------------------------------------------------

# herdr's server runs in the background; without one, start it headless.
if ! herdr workspace list >/dev/null 2>&1; then
  nohup herdr server >/dev/null 2>&1 &
  for _ in $(seq 1 40); do
    herdr workspace list >/dev/null 2>&1 && break
    sleep 0.25
  done
fi

# New panes get their environment from herdr's server, not from this shell, so the studio's variables are passed on.
ENV_ARGS=(--env "STUDIO_DIR=$STUDIO_DIR" --env "STUDIO_HOME=$STUDIO_HOME" --env "STUDIO_PORT=$STUDIO_PORT" --env "STUDIO_WHISPER_PORT=$STUDIO_WHISPER_PORT")
# The claude tab's Claude is the chat's: only its turns start features, make checkpoints and keep to the mode (lib/feature.js).
# Set on the pane, so a session the reaper stops and resumes there keeps it.
tab_env() { [ "$1" = claude ] && echo "--env STUDIO_ROLE=chat" || true; }

ws=$(herdr workspace list | jq -r --arg label "$WORKSPACE" '.result.workspaces[] | select(.label == $label) | .workspace_id' | head -n1)
first=""
if [ -z "$ws" ]; then
  created=$(herdr workspace create --cwd "$(tab_cwd claude)" --label "$WORKSPACE" --no-focus "${ENV_ARGS[@]}" $(tab_env claude))
  ws=$(echo "$created" | jq -r '.result.workspace.workspace_id')
  herdr tab rename "$(echo "$created" | jq -r '.result.tab.tab_id')" claude >/dev/null
  first=$(echo "$created" | jq -r '.result.root_pane.pane_id')
fi

tab_id() { herdr tab list --workspace "$ws" | jq -r --arg label "$1" '.result.tabs[] | select(.label == $label) | .tab_id' | head -n1; }
tab_pane() { herdr pane list --workspace "$ws" | jq -r --arg tab "$1" '[.result.panes[] | select(.tab_id == $tab)][0].pane_id'; }
at_prompt() { herdr pane process-info --pane "$1" 2>/dev/null | jq -e '.result.process_info | .foreground_process_group_id == .shell_pid' >/dev/null; }
# Connects rather than asking lsof, which only sees this user's processes: another user on this Mac (with their own
# studio) holds the same localhost ports, and the studio would otherwise start nothing and open their cockpit.
port_busy() { nc -z -G 1 127.0.0.1 "$1" >/dev/null 2>&1 || nc -z -G 1 ::1 "$1" >/dev/null 2>&1; }
blocked=""

start_in() {
  local name=$1 pane=$2 port
  port=$(tab_port "$name")
  if [ -n "$port" ] && port_busy "$port"; then
    echo "⚠️  $name: port $port is already in use (maybe by another user's studio on this Mac), so it can't start" >&2
    blocked="$blocked $name"
    return 1
  fi
  herdr pane run "$pane" "$(tab_command "$name")" >/dev/null
}

for name in $TABS; do
  if [ "$name" = claude ] && [ -n "$first" ]; then
    start_in claude "$first" && echo "claude: started"
    continue
  fi
  tab=$(tab_id "$name")
  if [ -z "$tab" ]; then
    pane=$(herdr tab create --workspace "$ws" --cwd "$(tab_cwd "$name")" --label "$name" --no-focus "${ENV_ARGS[@]}" $(tab_env "$name") | jq -r '.result.root_pane.pane_id')
    start_in "$name" "$pane" && echo "$name: started"
    continue
  fi
  pane=$(tab_pane "$tab")
  if [ "$name" = studio ] && [ -n "${STUDIO_UPDATED:-}" ] && ! at_prompt "$pane"; then
    herdr pane send-keys "$pane" C-c >/dev/null
    for _ in $(seq 1 20); do
      port_busy "$STUDIO_PORT" || break
      sleep 0.25
    done
  fi
  if at_prompt "$pane"; then
    start_in "$name" "$pane" && echo "$name: started again"
  else
    echo "$name: already running"
  fi
done

# --- the cockpit ----------------------------------------------------------------------------------

URL="http://localhost:$STUDIO_PORT"
if [ -n "$blocked" ]; then
  echo "Not everything started (blocked:$blocked). If another user on this Mac has the studio running, stop it there" >&2
  echo "with \`herdr server stop\`, then run \`studio up\` again." >&2
  # What answers on the cockpit's port isn't this studio, so don't open it.
  case " $blocked " in *" studio "*) exit 1 ;; esac
fi
for _ in $(seq 1 60); do
  curl -sf -o /dev/null "$URL/" && break
  sleep 0.25
done
curl -sf -o /dev/null "$URL/" || echo "⚠️  The cockpit isn't answering at $URL yet; see the studio tab in herdr." >&2
echo "Studio is at $URL"
[ -n "${STUDIO_NO_OPEN:-}" ] || open "$URL"
