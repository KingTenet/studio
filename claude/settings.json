{
  "env": {
    "CLAUDE_CODE_ARTIFACT_AUTO_OPEN": "0"
  },
  "permissions": {
    "allow": ["Bash(npm test)", "Bash(npm run typecheck)", "Bash(npm run build)", "Edit(./**)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/herdr-agent-state.sh\" session",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "python3 -I \"$STUDIO_DIR/hooks/studio-hook.py\" session-start",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$STUDIO_DIR/hooks/studio-hook.py\" prompt-submit",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Artifact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$STUDIO_DIR/scripts/lib/artifacts.js\" record",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$STUDIO_DIR/scripts/cc-command.sh\" flush",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
